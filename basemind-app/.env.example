# One group: its own Supabase project, living at the root of the site.
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional, only used to name the group on screen.
# VITE_ORG_NAME=14th Delport

# Several groups, each with its own Supabase project and its own slice of the
# address. Set this INSTEAD of the two variables above — it wins when present.
# A slug of "" keeps that group at the root; the rest live under /g/<slug>.
#
# VITE_ORGS=[{"slug":"","name":"14th Delport","url":"https://aaa.supabase.co","anonKey":"ey..."},{"slug":"2nd-pretoria","name":"2nd Pretoria","url":"https://bbb.supabase.co","anonKey":"ey..."}]
